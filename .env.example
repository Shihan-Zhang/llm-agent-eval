# 复制为 .env 后填写(.env 不进仓库)。scripts/*.ps1 运行时会自动读取这个文件。
# 硅基流动:用作评测裁判(LLM-as-Judge),以及 eval/run_eval.py 的 API 模型
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
JUDGE_MODEL=deepseek-ai/DeepSeek-V3.2

# HuggingFace 下载镜像(国内);能直连 huggingface.co 就留空
HF_ENDPOINT=https://hf-mirror.com

# 知识库检索服务 kb_service(scripts\run_kb_service.bat;只监听 127.0.0.1)
# 调用方的 API Key,逗号分隔可配多个;为空时服务拒绝启动。生成:python -c "import secrets;print(secrets.token_urlsafe(32))"
KB_SERVICE_API_KEYS=
KB_SERVICE_RATE_PER_MIN=30
KB_SERVICE_EMBED_TIMEOUT_S=30
KB_SERVICE_PORT=8765
